{
  "format": "liveframe-design-system/1",
  "id": "corpus",
  "version": "1",
  "values": {
    "space.1": {
      "kind": "spacing",
      "value": {
        "value": 4,
        "unit": "px"
      }
    },
    "motion.1": {
      "kind": "motion-duration",
      "value": {
        "value": 200,
        "unit": "ms"
      }
    }
  },
  "recipes": {
