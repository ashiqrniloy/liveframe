{
  "format": "liveframe/1",
  "catalogId": "proof.ui@1",
  "surfaceId": "corpus",
  "revision": 1,
  "root": {
    "id": "root",
    "kind": "stack",
    "props": {},
    "children": [
      {
        "id": "root/button",
        "kind": "button",
        "props": {
          "label": "Save"
        },
        "events": {
          "onPress": {
            "type": "action",
            "name": "tasks.claim",
            "args": {
              "id": "task:1"
            },
            "local": [
              {
                "key": "expanded",
                "value": true,
                "until": "revision"
              }
            ]
          }
        }
      },
      {
        "id": "root/field",
        "kind": "textField",
        "props": {
          "label": "Filter"
        },
        "events": {
          "onChange": {
            "type": "setState",
            "key": "selected",
            "local": [
              {
                "key": "q"
              },
              {
                "key": "expanded",
                "value": false
              }
            ]
          }
        }
      }
    ]
  }
}
