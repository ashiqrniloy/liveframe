{
  "format": "liveframe/1",
  "catalogId": "proof.ui@1",
  "surfaceId": "corpus",
  "revision": 1,
  "root": {
    "id": "root",
    "kind": "stack",
    "props": {},
    "children": [
      {
        "id": "root/row",
        "kind": "text",
        "props": {
          "text": "Row"
        },
        "when": {
          "$contains": [
            "Row",
            {
              "$path": "local.q"
            }
          ]
        }
      },
      {
        "id": "root/empty",
        "kind": "text",
        "props": {
          "text": "No matches"
        },
        "when": {
          "$eq": [
            {
              "$path": "shown"
            },
            0
          ]
        }
      },
      {
        "id": "root/count",
        "kind": "text",
        "props": {
          "text": ""
        },
        "bind": {
          "text": {
            "$text": {
              "$path": "shown"
            }
          }
        }
      }
    ]
  }
}
