{
  "name": "@arnilo/liveframe",
  "version": "0.1.0",
  "description": "Runtime-composable UI: primitives, design-system recipes and TSX widgets that change an app's UI without a deployment.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "author": "Niloy Rahman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/liveframe.git"
  },
  "homepage": "https://github.com/ashiqrniloy/liveframe#readme",
  "bugs": {
    "url": "https://github.com/ashiqrniloy/liveframe/issues"
  },
  "keywords": [
    "ui",
    "widgets",
    "tsx",
    "design-system",
    "runtime",
    "validation",
    "json-schema",
    "mcp",
    "bun"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "sideEffects": [
    "./dist/preview/worker/entry.js"
  ],
  "exports": {
    ".": {
      "liveframe:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": {
      "liveframe:source": "./src/css/index.ts",
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.js"
    },
    "./react": {
      "liveframe:source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./sdk": {
      "liveframe:source": "./src/sdk/index.ts",
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/gen": {
      "liveframe:source": "./src/sdk/gen.ts",
      "types": "./dist/sdk/gen.d.ts",
      "default": "./dist/sdk/gen.js"
    },
    "./sdk/jsx-runtime": {
      "liveframe:source": "./src/sdk/jsx-runtime.ts",
      "types": "./dist/sdk/jsx-runtime.d.ts",
      "default": "./dist/sdk/jsx-runtime.js"
    },
    "./sdk/jsx-dev-runtime": {
      "liveframe:source": "./src/sdk/jsx-dev-runtime.ts",
      "types": "./dist/sdk/jsx-dev-runtime.d.ts",
      "default": "./dist/sdk/jsx-dev-runtime.js"
    },
    "./schemas/*": "./schemas/*",
    "./pack": {
      "liveframe:source": "./src/pack/index.ts",
      "types": "./dist/pack/index.d.ts",
      "default": "./dist/pack/index.js"
    },
    "./store": {
      "liveframe:source": "./src/store/index.ts",
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./store/fs": {
      "liveframe:source": "./src/store/fs/index.ts",
      "types": "./dist/store/fs/index.d.ts",
      "default": "./dist/store/fs/index.js"
    },
    "./preview": {
      "liveframe:source": "./src/preview/index.ts",
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    },
    "./preview/worker": {
      "liveframe:source": "./src/preview/worker/index.ts",
      "types": "./dist/preview/worker/index.d.ts",
      "default": "./dist/preview/worker/index.js"
    },
    "./preview/react": {
      "liveframe:source": "./src/preview/react/index.ts",
      "types": "./dist/preview/react/index.d.ts",
      "default": "./dist/preview/react/index.js"
    },
    "./conformance": {
      "liveframe:source": "./src/conformance/index.ts",
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./conformance/react": {
      "liveframe:source": "./src/conformance/react/index.ts",
      "types": "./dist/conformance/react/index.d.ts",
      "default": "./dist/conformance/react/index.js"
    },
    "./preview/capture": {
      "liveframe:source": "./src/preview/capture/index.ts",
      "types": "./dist/preview/capture/index.d.ts",
      "default": "./dist/preview/capture/index.js"
    },
    "./authoring": {
      "liveframe:source": "./src/authoring/index.ts",
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "bin": {
    "liveframe": "./dist/cli/liveframe.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "bench": "bun --conditions liveframe:source bench/validator.bench.ts && bun --conditions liveframe:source bench/render.bench.ts && bun --conditions liveframe:source bench/css.bench.ts",
    "proof": "bun proof/host/server.ts",
    "test": "bun test --conditions liveframe:source src proof",
    "typecheck": "tsc --noEmit && tsc --noEmit -p proof",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "gen:check": "bun src/cli/liveframe.ts gen src/__tests__/fixtures/proof/catalog.json --out src/__tests__/fixtures/widgets/ui.gen.ts --check && bun src/cli/liveframe.ts gen src/__tests__/fixtures/proof/catalog.json --out src/__tests__/fixtures/widgets/ui.definitions.gen.ts --implementations --check && bun src/cli/liveframe.ts gen src/__tests__/fixtures/widgets/carries.json --out src/__tests__/fixtures/widgets/carries.definitions.gen.ts --implementations --check",
    "check": "bun run build && bun run gen:check && bun run typecheck && bun run lint && bun run format:check && bun run test",
    "release:gate": "bun scripts/release/archive-gate.ts",
    "release:stage": "bun scripts/release/publish-manifest.ts",
    "demo:test": "bun scripts/demo-test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "dependencies": {
    "acorn": "8.19.0",
    "sucrase": "3.35.1"
  }
}
