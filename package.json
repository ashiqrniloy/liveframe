{
  "name": "@arnilo/liveframe",
  "version": "0.0.0",
  "description": "Runtime-composable UI: primitives, design-system recipes and TSX widgets that change an app's UI without a deployment.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk/index.ts",
    "./sdk/jsx-runtime": "./src/sdk/jsx-runtime.ts",
    "./sdk/jsx-dev-runtime": "./src/sdk/jsx-dev-runtime.ts",
    "./schemas/*": "./schemas/*"
  },
  "files": ["src", "schemas"],
  "bin": {
    "liveframe": "./src/cli/liveframe.ts"
  },
  "scripts": {
    "bench": "bun bench/validator.bench.ts",
    "proof": "bun proof/host/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p proof",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "gen:check": "bun src/cli/liveframe.ts gen src/__tests__/fixtures/proof/catalog.json --out src/__tests__/fixtures/widgets/ui.gen.ts --check",
    "check": "bun run gen:check && bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
