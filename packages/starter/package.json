{
  "name": "@arnilo/liveframe-starter",
  "version": "0.3.0-rc.1",
  "description": "A starting point for a Liveframe host: a reference catalog, React implementations, themes and a design system that pass every conformance suite. Copy it or extend it.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "author": "Niloy Rahman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/liveframe.git",
    "directory": "packages/starter"
  },
  "homepage": "https://github.com/ashiqrniloy/liveframe#readme",
  "bugs": {
    "url": "https://github.com/ashiqrniloy/liveframe/issues"
  },
  "keywords": [
    "liveframe",
    "catalog",
    "react",
    "design-system",
    "bun"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "liveframe:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "liveframe:source": "./src/ui.gen.ts",
      "types": "./dist/ui.gen.d.ts",
      "default": "./dist/ui.gen.js"
    },
    "./definitions": {
      "liveframe:source": "./src/ui.definitions.gen.ts",
      "types": "./dist/ui.definitions.gen.d.ts",
      "default": "./dist/ui.definitions.gen.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@arnilo/liveframe": "~0.3.0-0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-aria-components": "^1.22.0"
  },
  "devDependencies": {
    "@arnilo/liveframe": "workspace:*"
  },
  "sideEffects": false
}
